{
  "$schema": "./manifest.schema.json",
  "version": 1,
  "description": "Canonical desired state for shareable AI coding tool configuration.",
  "resources": [
    {
      "id": "claude.settings",
      "tool": "claude",
      "kind": "config",
      "platforms": [
        "windows"
      ],
      "method": "symlink",
      "sourceCandidates": [
        "claude/configs/settings.windows.local.json",
        "claude/configs/settings.windows.json"
      ],
      "target": "${home}/.claude/settings.json",
      "description": "Claude Code settings; prefer the gitignored private Windows override when present."
    },
    {
      "id": "claude.instructions",
      "tool": "claude",
      "kind": "instructions",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "method": "symlink",
      "source": "claude/configs/CLAUDE.md",
      "target": "${home}/.claude/CLAUDE.md",
      "description": "User-wide Claude Code instructions."
    },
    {
      "id": "claude.statusline.windows",
      "tool": "claude",
      "kind": "script",
      "platforms": [
        "windows"
      ],
      "method": "symlink",
      "source": "claude/scripts/statusline.ps1",
      "target": "${home}/.claude/statusline.ps1",
      "description": "PowerShell status line used by Claude Code on Windows."
    },
    {
      "id": "codex.config",
      "tool": "codex",
      "kind": "config",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "method": "seed",
      "source": "codex/config.toml.example",
      "target": "${home}/.codex/config.toml",
      "description": "Machine-specific Codex configuration seeded once and never overwritten."
    },
    {
      "id": "codex.prompt.checkpoint",
      "tool": "codex",
      "kind": "prompt",
      "platforms": [
        "windows"
      ],
      "method": "symlink",
      "source": "codex/prompts/checkpoint.md",
      "target": "${home}/.codex/prompts/checkpoint.md",
      "description": "Codex slash-menu checkpoint adapter."
    },
    {
      "id": "codex.instructions",
      "tool": "codex",
      "kind": "instructions",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "method": "symlink",
      "source": "codex/AGENTS.md",
      "target": "${home}/.codex/AGENTS.md",
      "description": "Codex 本机根原则。"
    },
    {
      "id": "codex.workflow-hook",
      "tool": "codex",
      "kind": "script",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "method": "symlink",
      "source": "codex/hooks/workflow-hook.py",
      "target": "${home}/.codex/hooks/workflow-hook.py",
      "description": "Codex 规范检查入口；install-workflow.py 合并四项事件，保留已有 hooks.json 配置。"
    },
    {
      "id": "hermes.workflow-plugin",
      "tool": "hermes",
      "kind": "script",
      "platforms": ["macos", "linux"],
      "method": "symlink",
      "source": "hermes/workflow-plugin",
      "target": "${home}/.hermes/plugins/starrybei-workflow",
      "description": "Hermes 规范插件；install-workflow.py 同时合并 plugins.enabled。仅建立链接不代表运行时已启用。"
    }
  ]
}
